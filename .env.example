# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Payment Gateway (Razorpay) - Keep server-side only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional WhatsApp Business Cloud API - Keep server-side only
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional Email Provider (SMTP / Resend) - Keep server-side only
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
